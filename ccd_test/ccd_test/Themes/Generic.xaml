    <Style TargetType="{x:Type local:GeometryImage}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:GeometryImage}">
                    <Image/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Resources>
            <Style TargetType="Image">
                <Setter Property="Source">
                    <Setter.Value>
                        <DrawingImage>
                            <DrawingImage.Drawing>
                                <GeometryDrawing Brush="{Binding IconColor, RelativeSource={RelativeSource TemplatedParent}}"
                                                 Geometry="{Binding IconGeometry, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </DrawingImage.Drawing>
                        </DrawingImage>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
    </Style>

    <Style TargetType="{x:Type local:ToggleSwitch}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ToggleSwitch}">
                    <Image/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Resources>
            <Style TargetType="Image">
                <Setter Property="Source">
                    <Setter.Value>
                        <DrawingImage>
                            <DrawingImage.Drawing>
                                <GeometryDrawing Brush="{StaticResource StrongColor}"
                                                 Geometry="{StaticResource toggle_switch_off}"/>
                            </DrawingImage.Drawing>
                        </DrawingImage>
                    </Setter.Value>
                </Setter>

                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                        <Setter Property="Source">
                            <Setter.Value>
                                <DrawingImage>
                                    <DrawingImage.Drawing>
                                        <GeometryDrawing Brush="{StaticResource OnColor}"
                                                         Geometry="{StaticResource toggle_switch_on}"/>
                                    </DrawingImage.Drawing>
                                </DrawingImage>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True"/>
                            <Condition Binding="{Binding Path=IsEnabled, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter Property="Source">
                                <Setter.Value>
                                    <DrawingImage>
                                        <DrawingImage.Drawing>
                                            <GeometryDrawing Brush="{StaticResource DisabledOnColor}"
                                                             Geometry="{StaticResource toggle_switch_on}"/>
                                        </DrawingImage.Drawing>
                                    </DrawingImage>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False"/>
                            <Condition Binding="{Binding Path=IsEnabled, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter Property="Source">
                                <Setter.Value>
                                    <DrawingImage>
                                        <DrawingImage.Drawing>
                                            <GeometryDrawing Brush="{StaticResource DisabledOffColor}"
                                                             Geometry="{StaticResource toggle_switch_off}"/>
                                        </DrawingImage.Drawing>
                                    </DrawingImage>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Style.Resources>
    </Style>

    <Style TargetType="{x:Type local:ToggleIcon}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ToggleIcon}">
                    <Border Background="{Binding ImageBackground, RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="10">
                        <Image Margin="{Binding ImageMargin, RelativeSource={RelativeSource TemplatedParent}}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Resources>
            <Style TargetType="Image">
                <Setter Property="Source">
                    <Setter.Value>
                        <DrawingImage>
                            <DrawingImage.Drawing>
                                <GeometryDrawing Brush="{Binding IconColor, RelativeSource={RelativeSource TemplatedParent}}"
                                                 Geometry="{Binding IconGeometry, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </DrawingImage.Drawing>
                        </DrawingImage>
                    </Setter.Value>
                </Setter>

                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                        <Setter Property="Source">
                            <Setter.Value>
                                <DrawingImage>
                                    <DrawingImage.Drawing>
                                        <GeometryDrawing Brush="{Binding CheckedIconColor, RelativeSource={RelativeSource TemplatedParent}}"
                                                         Geometry="{Binding CheckedIconGeometry, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </DrawingImage.Drawing>
                                </DrawingImage>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Style.Resources>
    </Style>

    <Style TargetType="{x:Type local:ButtonIcon}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ButtonIcon}">
                    <Border Background="{Binding ImageBackground, RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="10">
                        <Image Margin="{Binding ImageMargin, RelativeSource={RelativeSource TemplatedParent}}">
                            <Image.Source>
                                <DrawingImage>
                                    <DrawingImage.Drawing>
                                        <GeometryDrawing Brush="{Binding IconColor, RelativeSource={RelativeSource TemplatedParent}}"
                                                         Geometry="{Binding IconGeometry, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </DrawingImage.Drawing>
                                </DrawingImage>
                            </Image.Source>
                        </Image>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="False"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type local:ButtonIcon}">
                                <Border Background="{Binding ImageBackground, RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="10">
                                    <Image Margin="{Binding ImageMargin, RelativeSource={RelativeSource TemplatedParent}}">
                                        <Image.Source>
                                            <DrawingImage>
                                                <DrawingImage.Drawing>
                                                    <GeometryDrawing Brush="{StaticResource ButtonClick}"
                                                                     Geometry="{Binding IconGeometry, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                </DrawingImage.Drawing>
                                            </DrawingImage>
                                        </Image.Source>
                                    </Image>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type local:RadioButtonIcon}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RadioButtonIcon}">
                    <Grid Background="Transparent">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Margin="{Binding ImageMargin, RelativeSource={RelativeSource TemplatedParent}}">
                                <Image.Source>
                                    <DrawingImage>
                                        <DrawingImage.Drawing>
                                            <GeometryDrawing
                                                Brush="{StaticResource DemiStrong}"
                                                Geometry="{Binding IconGeometry, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        </DrawingImage.Drawing>
                                    </DrawingImage>
                                </Image.Source>
                            </Image>
                            <Label
                                FontSize="12"
                                Content="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                Foreground="{StaticResource DemiStrong}"/>
                        </StackPanel>
                        <Line
                            X1="0"
                            X2="{TemplateBinding ActualWidth}"
                            Y1="{TemplateBinding ActualHeight}"
                            Y2="{TemplateBinding ActualHeight}"
                            StrokeThickness="1" Stroke="{StaticResource DemiStrong}" Margin="0,0,0,-1"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:RadioButtonIcon}">
                            <Grid Background="Transparent">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Image Margin="{Binding ImageMargin, RelativeSource={RelativeSource TemplatedParent}}">
                                        <Image.Source>
                                            <DrawingImage>
                                                <DrawingImage.Drawing>
                                                    <GeometryDrawing
                                                        Brush="{StaticResource StrongColor}"
                                                        Geometry="{Binding IconGeometry, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                </DrawingImage.Drawing>
                                            </DrawingImage>
                                        </Image.Source>
                                    </Image>
                                    <Label
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Content="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                        Foreground="{StaticResource StrongColor}"/>
                                </StackPanel>
                                <Line
                                    X1="0"
                                    X2="{TemplateBinding ActualWidth}"
                                    Y1="{TemplateBinding ActualHeight}"
                                    Y2="{TemplateBinding ActualHeight}"
                                    StrokeThickness="2.5" Stroke="{StaticResource ContrastColor}" Margin="0,0,0,-1.25"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>