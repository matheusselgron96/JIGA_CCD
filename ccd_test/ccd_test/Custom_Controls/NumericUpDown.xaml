<UserControl x:Class="ccd_test.NumericUpDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ccd_test"
             mc:Ignorable="d"
             MinWidth="25" MinHeight="30"
             d:DesignHeight="250" d:DesignWidth="500"
             SizeChanged="UserControl_SizeChanged">
    <Border CornerRadius="10" BorderBrush="Red" x:Name="brdMain"
            Background="{StaticResource Level1Background}">
        <Grid x:Name="gdMain">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <!--The Value itself-->
            <Label x:Name="lbValue"
                   Grid.RowSpan="5" 
                   VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                   VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                   TargetUpdated="lbValue_TargetUpdated"
                   MouseLeftButtonDown="lbValue_MouseLeftButtonDown">
                <TextBlock>
                        <Run Name="TextValue" Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:NumericUpDown}}, Path=Value, NotifyOnTargetUpdated=True}"/><Run Name="TextCustomUnit" Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:NumericUpDown}}, Path=CustomUnit}"/>
                </TextBlock>
            </Label>

            <!--Up Button-->
            <RepeatButton x:Name="btUp"                          
                          FontFamily="Marlett"
                          FontSize="90"                          
                          Grid.Column="1" 
                          Interval="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:NumericUpDown}}, Path=Interval}"
                          Delay="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:NumericUpDown}}, Path=Delay}"
                          Focusable="False"
                          PreviewMouseUp="Up_PreviewMouseUp">
                <Image Margin="8">
                    <Image.Source>
                        <DrawingImage>
                            <DrawingImage.Drawing>
                                <GeometryDrawing Brush="{StaticResource StrongColor}"
                                                 Geometry="{StaticResource chevron_up}"/>
                            </DrawingImage.Drawing>
                        </DrawingImage>
                    </Image.Source>
                </Image>
            </RepeatButton>

            <!--Down Button-->
            <RepeatButton x:Name="btDown"
                          FontFamily="Marlett"
                          FontSize="90"
                          Grid.Row="1"
                          Grid.Column="1"
                          Interval="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:NumericUpDown}}, Path=Interval}"
                          Delay="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:NumericUpDown}}, Path=Delay}"
                          Focusable="False"
                          PreviewMouseUp="Down_PreviewMouseUp">
                <Image Margin="8">
                    <Image.Source>
                        <DrawingImage>
                            <DrawingImage.Drawing>
                                <GeometryDrawing Brush="{StaticResource StrongColor}"
                                                 Geometry="{StaticResource chevron_down}"/>
                            </DrawingImage.Drawing>
                        </DrawingImage>
                    </Image.Source>
                </Image>
            </RepeatButton>
        </Grid>
    </Border>
</UserControl>