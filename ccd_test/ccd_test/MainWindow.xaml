<Window x:Class="ccd_test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:ccd_test.UC_Screens"
        xmlns:local="clr-namespace:ccd_test"
        mc:Ignorable="d"
        Title="MainWindow" Height="768" Width="1024"
        Closing="Window_Closing"
        ContentRendered="Window_ContentRendered">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <ContentControl x:Name="osc" Grid.Row="0" Margin="0,5,0,0"/>

        <Grid Grid.Row="1" x:Name="gdControls">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Grid.Row="1" Width="32" Height="32" Fill="Red" x:Name="ellpsWIZnetStatus" />

                <Label Grid.Column="1" Grid.Row="1" Content="WIZnet" HorizontalAlignment="Left"/>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Button x:Name="btStart" Grid.Row="1" Content="Start" Click="btStart_Click" Margin="4"/>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Button x:Name="btStop" Grid.Row="1" Content="Stop" Click="btStop_Click" Margin="4"/>
            </Grid>

            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Content="R Gain" Grid.Row="0"/>
                <Label Content="G Gain" Grid.Row="1"/>
                <Label Content="B Gain" Grid.Row="2"/>

                <Button x:Name="btRGain1" Grid.Row="0" Grid.Column="1" Content="1" Click="btRGain1_Click" Margin="4"/>
                <Button x:Name="btGGain1" Grid.Row="1" Grid.Column="1" Content="1" Click="btGGain1_Click" Margin="4"/>
                <Button x:Name="btBGain1" Grid.Row="2" Grid.Column="1" Content="1" Click="btBGain1_Click" Margin="4"/>

                <Button x:Name="btRGain500" Grid.Row="0" Grid.Column="2" Content="500" Click="btRGain500_Click" Margin="4"/>
                <Button x:Name="btGGain500" Grid.Row="1" Grid.Column="2" Content="500" Click="btGGain500_Click" Margin="4"/>
                <Button x:Name="btBGain500" Grid.Row="2" Grid.Column="2" Content="500" Click="btBGain500_Click" Margin="4"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
