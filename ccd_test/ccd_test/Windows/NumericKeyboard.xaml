<Window x:Class="ccd_test.Windows.NumericKeyboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ccd_test"
        xmlns:windows="clr-namespace:ccd_test.Windows"        
        Style="{StaticResource DefaultWindow}" 
        WindowStartupLocation="CenterOwner"
        MouseDown="Window_MouseDown"
        Height="540" Width="440"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="4" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ClickMode" Value="Press" />
        </Style>
    </Window.Resources>

    <Grid x:Name="gdMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="2.3*"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="1.7*"/>
        </Grid.RowDefinitions>

        <!--Numbers/Password input box-->
        <Grid Grid.Row="0" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="auto" MinHeight="32"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!--Number and Password-->
            <Button x:Name="btMinus" Margin="0, 4" Width="40"
                    Click="btMinus_Click">
                <Label Content="-" FontSize="48"/>
            </Button>

            <!--Value-->
            <TextBox x:Name="tboxValue" Text="" Grid.Column="1" FontSize="32" MaxLength="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type windows:NumericKeyboard}}, Path=MaxLength}" 
                         HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Margin="4" />

            <!--Clear Button-->
            <Button x:Name="btClear" Content="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type windows:NumericKeyboard}}, Path=TextClear}" FontSize="20" Grid.Column="2"
                    Click="btClear_Click"/>

            <!--Display Min and Max Values-->
            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="4,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Label x:Name="lbDisplayMinMax" Foreground="DarkBlue" Grid.Row="0">
                    <TextBlock TextAlignment="Center" >
                        <Run Text="{DynamicResource ucNumericKeyboardTypeBetween1}"/>
                        <Run x:Name="tblockMinValue" FontWeight="SemiBold"/>
                        <Run Text="{DynamicResource ucNumericKeyboardTypeBetween2}"/>
                        <Run x:Name="tblockMaxValue" FontWeight="SemiBold"/>
                    </TextBlock>
                </Label>

                <Label x:Name="lbDisplayMultipleOf" Foreground="DarkBlue" Visibility="Collapsed" Grid.Row="1">
                    <TextBlock TextAlignment="Center">
                        <Run Text="{DynamicResource ucNumericKeyboardMultiplyOf}"/>
                        <Run x:Name="tblockMultipleOf" FontWeight="SemiBold"/>
                    </TextBlock>
                </Label>
            </Grid>
        </Grid>

        <!--Number Keyboard-->
        <Grid x:Name="gdNumbers" Grid.Row="1" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button Content="7" Grid.Row="0" Grid.Column="0" Click="btNumber_Click"/>
            <Button Content="8" Grid.Row="0" Grid.Column="1" Click="btNumber_Click"/>
            <Button Content="9" Grid.Row="0" Grid.Column="2" Click="btNumber_Click"/>

            <Button Content="4" Grid.Row="1" Grid.Column="0" Click="btNumber_Click"/>
            <Button Content="5" Grid.Row="1" Grid.Column="1" Click="btNumber_Click"/>
            <Button Content="6" Grid.Row="1" Grid.Column="2" Click="btNumber_Click"/>

            <Button Content="1" Grid.Row="2" Grid.Column="0" Click="btNumber_Click"/>
            <Button Content="2" Grid.Row="2" Grid.Column="1" Click="btNumber_Click"/>
            <Button Content="3" Grid.Row="2" Grid.Column="2" Click="btNumber_Click"/>

            <Button Content="0" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Click="btNumber_Click"/>
        </Grid>

        <!--Confirmation Row-->
        <Grid Grid.Row="2" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="btConfirm" Content="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type windows:NumericKeyboard}}, Path=TextConfirm}" FontSize="20" Grid.Column="0"
                    Click="btConfirm_Click" ClickMode="Release"/>
            <Button x:Name="btCancel" Content="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type windows:NumericKeyboard}}, Path=TextCancel}" FontSize="20" Grid.Column="1"
                    Click="btCancel_Click" ClickMode="Release"/>
        </Grid>
    </Grid>
</Window>